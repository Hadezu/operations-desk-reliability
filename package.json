{
  "name": "operations-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#prisma-client": {
      "workerd": "./.generated/prisma-edge/client.ts",
      "default": "./.generated/prisma/client.ts"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "sharp": "0.35.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "dev:web": "next dev apps/web --webpack -p 3100",
    "build": "npm run db:generate && tsx scripts/prepare-evidence.ts && next build apps/web --webpack",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:verify-access": "tsx scripts/verify-database-access.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "api": "tsx apps/api/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:recovery": "tsx tests/worker-recovery.ts",
    "verify": "npm run db:generate && npm run cf:types && tsx scripts/verify.ts",
    "format": "prettier --write apps packages prisma scripts tests .github *.json *.ts *.yaml *.jsonc",
    "cf:types": "wrangler types",
    "contracts": "tsx scripts/contracts.ts",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir .cloudflare-build",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "dotenv": "18.0.6",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
