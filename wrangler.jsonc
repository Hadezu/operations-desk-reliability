{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "operations-desk-reliability",
  "main": "apps/cloudflare/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "alias": { "#prisma-client": "./.generated/prisma-edge/client.ts" },
  "assets": {
    "directory": "apps/web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "version_metadata": { "binding": "VERSION" },
  "secrets": { "required": ["NEON_DATABASE_URL"] },
  "vars": {
    "APP_ORIGIN": "https://operations-desk-reliability.vanya-matyushkin.workers.dev",
    "DEMO_DAILY_LIMIT": "40",
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "68034b0e44944f9da8a61a1dcf9c9231" },
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "26100701",
      "simple": { "limit": 90, "period": 60 },
    },
    {
      "name": "DEMO_LIMIT",
      "namespace_id": "26100702",
      "simple": { "limit": 4, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 * * * *"] },
}
